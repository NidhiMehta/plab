{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/plab/v0.3/summary.schema.json",
  "title": "PLAB v0.3 Benchmark Summary",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "benchmark",
    "n_results",
    "measurement_principle",
    "overall",
    "by_domain",
    "by_attack_family",
    "by_difficulty",
    "domain_x_attack",
    "attack_x_difficulty",
    "domain_x_difficulty",
    "paired_difficulty"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.3"
    },

    "benchmark": {
      "type": "string",
      "const": "PLAB"
    },

    "n_results": {
      "type": "integer",
      "minimum": 0
    },

    "measurement_principle": {
      "type": "string"
    },

    "overall": {
      "$ref": "#/$defs/metrics"
    },

    "by_domain": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metrics"
      }
    },

    "by_attack_family": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metrics"
      }
    },

    "by_difficulty": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metrics"
      }
    },

    "domain_x_attack": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/metrics"
        }
      }
    },

    "attack_x_difficulty": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/metrics"
        }
      }
    },

    "domain_x_difficulty": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/metrics"
        }
      }
    },

    "paired_difficulty": {
      "$ref": "#/$defs/paired"
    }
  },

  "$defs": {
    "nullable_number": {
      "type": [
        "number",
        "null"
      ]
    },

    "metrics": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "n",
        "pass_rate",
        "failure_rate",
        "exact_disclosure_rate",
        "partial_disclosure_rate",
        "inference_leakage_rate",
        "reconstructable_rate",
        "authorization_violation_rate",
        "tool_authorization_violation_rate",
        "cross_user_violation_rate",
        "mean_leakage_level",
        "median_first_leak_turn",
        "exact_recovery_rate",
        "mean_turns"
      ],

      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },

        "pass_rate": {
          "$ref": "#/$defs/nullable_number"
        },

        "failure_rate": {
          "$ref": "#/$defs/nullable_number"
        },

        "exact_disclosure_rate": {
          "$ref": "#/$defs/nullable_number"
        },

        "partial_disclosure_rate": {
          "$ref": "#/$defs/nullable_number"
        },

        "inference_leakage_rate": {
          "$ref": "#/$defs/nullable_number"
        },

        "reconstructable_rate": {
          "$ref": "#/$defs/nullable_number"
        },

        "authorization_violation_rate": {
          "$ref": "#/$defs/nullable_number"
        },

        "tool_authorization_violation_rate": {
          "$ref": "#/$defs/nullable_number"
        },

        "cross_user_violation_rate": {
          "$ref": "#/$defs/nullable_number"
        },

        "mean_leakage_level": {
          "$ref": "#/$defs/nullable_number"
        },

        "median_first_leak_turn": {
          "$ref": "#/$defs/nullable_number"
        },

        "exact_recovery_rate": {
          "$ref": "#/$defs/nullable_number"
        },

        "mean_turns": {
          "$ref": "#/$defs/nullable_number"
        }
      }
    },

    "paired": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "n_pairs",
        "easy_to_medium_failure_delta",
        "medium_to_hard_failure_delta",
        "easy_to_hard_failure_delta",
        "easy_to_hard_leakage_delta"
      ],

      "properties": {
        "n_pairs": {
          "type": "integer",
          "minimum": 0
        },

        "easy_to_medium_failure_delta": {
          "$ref": "#/$defs/nullable_number"
        },

        "medium_to_hard_failure_delta": {
          "$ref": "#/$defs/nullable_number"
        },

        "easy_to_hard_failure_delta": {
          "$ref": "#/$defs/nullable_number"
        },

        "easy_to_hard_leakage_delta": {
          "$ref": "#/$defs/nullable_number"
        }
      }
    }
  }
}

