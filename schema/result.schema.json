{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/plab/v0.3/result.schema.json",
  "title": "PLAB v0.3 Evaluation Result",
  "description": "Machine-readable result for one PLAB privacy/security test case.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "benchmark",
    "case_id",
    "model",
    "trace",
    "evaluation",
    "attack_cost",
    "status"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.3"
    },

    "benchmark": {
      "type": "string",
      "const": "PLAB"
    },

    "case_id": {
      "type": "string",
      "minLength": 1
    },

    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    },

    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turns",
        "messages",
        "tool_calls"
      ],
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0
        },

        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },

        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_call"
          }
        },

        "termination_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "model_finished",
            "policy_denial",
            "attack_budget_exhausted",
            "tool_budget_exhausted",
            "runtime_error",
            "evaluation_error"
          ]
        }
      }
    },

    "evaluation": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "leakage_level",
        "exact_disclosure",
        "partial_disclosure",
        "inference_leakage",
        "reconstructable",
        "authorization_violation",
        "tool_authorization_violation",
        "cross_user_violation"
      ],

      "properties": {
        "leakage_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },

        "exact_disclosure": {
          "type": "boolean"
        },

        "partial_disclosure": {
          "type": "boolean"
        },

        "inference_leakage": {
          "type": "boolean"
        },

        "reconstructable": {
          "type": "boolean"
        },

        "authorization_violation": {
          "type": "boolean"
        },

        "tool_authorization_violation": {
          "type": "boolean"
        },

        "cross_user_violation": {
          "type": "boolean"
        },

        "target_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "leaked_assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leaked_asset"
          }
        },

        "judge": {
          "$ref": "#/$defs/judge"
        }
      }
    },

    "attack_cost": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "turns",
        "input_tokens",
        "output_tokens",
        "tool_calls_attempted",
        "tool_calls_allowed"
      ],

      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0
        },

        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },

        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },

        "tool_calls_attempted": {
          "type": "integer",
          "minimum": 0
        },

        "tool_calls_allowed": {
          "type": "integer",
          "minimum": 0
        },

        "first_leak_turn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },

        "exact_recovery_turn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },

        "first_leak_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },

        "exact_recovery_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },

    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "inconclusive",
        "error"
      ]
    }
  },

  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "turn",
        "role",
        "content"
      ],

      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 0
        },

        "role": {
          "type": "string",
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ]
        },

        "content": {
          "type": "string"
        }
      }
    },

    "tool_call": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "turn",
        "name",
        "arguments",
        "authorized",
        "executed"
      ],

      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 0
        },

        "name": {
          "type": "string"
        },

        "arguments": {
          "type": "object",
          "additionalProperties": true
        },

        "authorized": {
          "type": "boolean"
        },

        "executed": {
          "type": "boolean"
        },

        "result_available": {
          "type": "boolean"
        },

        "blocked_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "leaked_asset": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "asset_id",
        "leakage_type",
        "severity"
      ],

      "properties": {
        "asset_id": {
          "type": "string"
        },

        "leakage_type": {
          "type": "string",
          "enum": [
            "none",
            "contextual",
            "partial",
            "inference",
            "reconstruction",
            "exact"
          ]
        },

        "severity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },

        "turn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },

    "judge": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "judge_model": {
          "type": [
            "string",
            "null"
          ]
        },

        "leakage_level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },

        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },

        "rationale": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

